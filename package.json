{
  "name": "gatehouse",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "policy:replay": "npm run replay -w @gatehouse/policy --",
    "audit:verify": "tsx packages/shared/src/audit/verify-cli.ts",
    "approver": "npm run start -w @gatehouse/approver",
    "host": "npm run start -w @gatehouse/host",
    "host:cli": "npm run cli -w @gatehouse/host --",
    "host:spike": "npm run spike -w @gatehouse/host --",
    "relay": "npm run start -w @gatehouse/relay",
    "relay:build-phone": "npm run build -w @gatehouse/phone",
    "package": "node scripts/package.mjs",
    "package:check": "node scripts/package.mjs --check",
    "installer": "node scripts/installer.mjs",
    "gate": "node scripts/gate.mjs",
    "install:local": "node scripts/install-local.mjs",
    "release": "tsx scripts/release.ts ship",
    "release:version": "tsx scripts/release.ts version"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/picomatch": "4.0.3",
    "@types/ws": "8.18.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5",
    "ws": "8.22.0"
  }
}
