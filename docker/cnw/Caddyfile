# TLS for CNW. With a public name, caddy gets a Let's Encrypt certificate. On a home network (a .home.arpa or .lan
# name), use "tls internal" and trust caddy's root certificate on your devices (docs/neighbourhood-watch.md).
{$CNW_HOST} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
		-Server
	}
	reverse_proxy 172.30.0.20:8080 {
		header_up X-Forwarded-For {remote_host}
	}
}
